{
  "name": "rose-pine-dawn-coverage",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-css.mjs",
    "build:check": "node scripts/build-css.mjs --check",
    "watch": "node scripts/watch-css.mjs",
    "pretest": "npm run build:check",
    "test": "node --test --test-concurrency=1",
    "test:coverage": "node scripts/theme-coverage.mjs",
    "check:installation": "node scripts/theme-coverage.mjs --check-installation --strict",
    "coverage:scenarios": "node scripts/theme-coverage.mjs --list-scenarios"
  },
  "devDependencies": {
    "sass": "1.106.1"
  }
}
